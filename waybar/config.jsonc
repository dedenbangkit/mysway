// Waybar — ported from github.com/dedenbangkit/my-i3wm
// top = main Regolith bar (conf.d), bottom = 71_bar_bottom (conf.d.bottom)
[
  {
    "name": "top",
    "fixed-center": false,
    "layer": "top",
    "position": "top",
    "height": 24,
    "spacing": 0,
    "modules-left": [
      "sway/workspaces",
      "sway/mode"
    ],
    "modules-right": [
      "cpu",
      "disk",
      "memory",
      "custom/updates",
      "network#traffic",
      "network#ip",
      "clock",
      "battery",
      "pulseaudio",
      "tray"
    ],
    "sway/workspaces": {
      "disable-scroll": true,
      "all-outputs": false,
      "format": "{name}"
    },
    "sway/mode": {
      "format": " {}"
    },
    "cpu": {
      "interval": 5,
      "format": "<span color='#db0469'></span> {usage:02}%",
      "on-click": "foot -e top"
    },
    "disk": {
      "interval": 240,
      "path": "/",
      "format": "<span color='#d1c182'></span> {free}",
      "on-click": "gnome-disks"
    },
    "memory": {
      "interval": 10,
      "format": "<span color='#d1c182'></span> {avail:0.1f}G",
      "tooltip-format": "{used:0.1f}G used of {total:0.1f}G"
    },
    "custom/updates": {
      "exec": "~/.config/waybar/scripts/updates",
      "return-type": "json",
      "interval": 3600,
      "signal": 9,
      "format": "<span color='#d1c182'></span> {}"
    },
    "network#traffic": {
      "interval": 5,
      "format-wifi": "<span color='#38ab03'></span>  {bandwidthDownBytes}<span color='#38ab03'>▾</span> {bandwidthUpBytes}<span color='#38ab03'>▴</span>",
      "format-ethernet": "<span color='#38ab03'>󰈀</span>  {bandwidthDownBytes}<span color='#38ab03'>▾</span> {bandwidthUpBytes}<span color='#38ab03'>▴</span>",
      "format-disconnected": "<span color='#c92c2c'>󰖪</span>  offline",
      "tooltip-format-wifi": "{essid} ({signalStrength}%)",
      "on-click": "env XDG_CURRENT_DESKTOP=GNOME gnome-control-center wifi"
    },
    "network#ip": {
      "interval": 30,
      "format": "{ipaddr}",
      "format-disconnected": "",
      "tooltip-format": "{ifname} via {gwaddr}"
    },
    "clock": {
      "interval": 10,
      "locale": "id_ID.UTF-8",
      "format": "<span color='#c92c2c'></span>  {:L%A %d %b %y %H:%M}",
      "tooltip-format": "<tt>{calendar}</tt>",
      "on-click": "firefox --new-tab https://calendar.google.com/calendar/u/1/r",
      "calendar": {
        "mode": "month",
        "format": {
          "today": "<span color='#3584E4'><b>{}</b></span>"
        }
      }
    },
    "battery": {
      "interval": 10,
      "states": {
        "warning": 50,
        "critical": 20
      },
      "format": "<span color='#38ab03'>{icon}</span> {capacity}%",
      "format-charging": "<span color='#38ab03'>󰂄</span> {capacity}%",
      "format-icons": [
        "",
        "",
        "",
        "",
        ""
      ],
      "tooltip-format": "{timeTo}"
    },
    "pulseaudio": {
      "format": "<span color='#d1c182'>{icon}</span> {volume}%",
      "format-muted": "<span color='#c92c2c'></span> mute",
      "format-icons": {
        "default": [
          "",
          "",
          ""
        ]
      },
      "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
      "on-click-right": "pavucontrol"
    },
    "tray": {
      "icon-size": 14,
      "spacing": 8
    }
  },
  {
    "name": "bottom",
    "layer": "top",
    "position": "bottom",
    "height": 24,
    "spacing": 0,
    "modules-left": [
      "sway/window"
    ],
    "modules-right": [
      "mpd",
      "custom/copyq",
      "custom/record",
      "custom/screenshot"
    ],
    // Focused window: app icon in an inverted gold block (like the quote had) + title cropped at max-length.
    // Every rule matching the raw "app_id|title" is applied, so the rules must not overlap:
    // the last one is the fallback for apps not listed above it.
    "sway/window": {
      "format": "{app_id}|{title}",
      "max-length": 80,
      "rewrite": {
        "^firefox[^|]*\\|(.*?)(?: — Mozilla Firefox)?$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^foot\\|(?!.* - Nvim$)(?:(?:◐|◓|◑|◒|✳|·|\\*) )?(.*)$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^foot\\|(.*) - Nvim$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^slack\\|(.*?)(?: - Slack)?$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^org\\.gnome\\.nautilus\\|(.*)$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^mpv\\|(.*)$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^emacs\\|(.*?)(?: (?:–|-) (?:Doom|GNU) Emacs.*)?$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^(?!firefox|foot\\||slack\\||org\\.gnome\\.nautilus\\||mpv\\||emacs\\|)[^|]*\\|(.+)$": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> $1",
        "^\\|$": ""
      },
      "icon": false
    },
    // Quote is off for now (not in modules-left); config kept to switch it back on.
    "custom/quote": {
      "exec": "~/.config/waybar/scripts/quote",
      "interval": 1200,
      "format": "<span background='#998d5c' color='#2b2b2b'> <span letter_spacing='6656'></span> </span> {}",
      "on-click": "pkill -RTMIN+8 waybar",
      "signal": 8,
      "tooltip": false
    },
    "mpd": {
      "format": "<span color='#d1c182'>\uf001</span>  {artist} - {title}",
      "format-paused": "<span color='#d1c182'>\uf04c</span>  {artist} - {title}",
      "format-stopped": "",
      "format-disconnected": "",
      "max-length": 60,
      "interval": 5,
      "tooltip-format": "{album}\nClick: play/pause · Middle-click: stop · Right-click: pick a song · Scroll: next/previous",
      "on-click": "mpc -q toggle",
      "on-click-middle": "mpc -q stop",
      "on-click-right": "~/.config/sway/scripts/music",
      "on-scroll-up": "mpc -q prev",
      "on-scroll-down": "mpc -q next"
    },
    "custom/copyq": {
      "format": "\uf0ea",
      "tooltip-format": "Clipboard history (CopyQ)\nRight-click: menu",
      "on-click": "copyq toggle",
      "on-click-right": "copyq menu"
    },
    "custom/record": {
      "exec": "~/.config/sway/scripts/record status",
      "return-type": "json",
      "interval": 2,
      "signal": 10,
      "on-click": "~/.config/sway/scripts/record"
    },
    "custom/screenshot": {
      "format": "",
      "tooltip-format": "Screenshot: area, window or screen → ~/Pictures + clipboard\nRight-click: whole screen",
      "on-click": "~/.config/sway/scripts/screenshot",
      "on-click-right": "~/.config/sway/scripts/screenshot screen"
    }
  }
]
