#!/usr/bin/env python3
"""Waybar: the current or next meeting, e.g. "14:00 Jacob Weekly Check In · 25m" or
"tomorrow 11:00 Wins form feedback". Looks up to a week ahead.

Runs every 60 s but only reads a cache; Google is asked (via gcalcli, ~1.6 s, ~74 MB while it
runs) at most every 5 minutes, in the background. Hidden only when the next week is empty.
"""
import datetime as dt
import html
import json
import os
import subprocess
import time

CALENDARS = ["deden@akvo.org", "Akvo Meetings"]
SKIP = {"Lunch", "Dinner"}  # own time blocks, not meetings
MAX_AGE = 300  # seconds before the cache is refreshed
SOON = 10  # minutes: turn red
GCALCLI = os.path.expanduser("~/.local/bin/gcalcli")  # pipx; not on waybar's PATH
run = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
CACHE, LOCK = f"{run}/next-meeting.tsv", f"{run}/next-meeting.lock"


def age(path):
    try:
        return time.time() - os.path.getmtime(path)
    except OSError:
        return float("inf")


def refresh():
    # one fetch at a time; a lock older than 60 s is a fetch that died
    if age(LOCK) < 60:
        return
    open(LOCK, "w").close()
    cmd = [GCALCLI]
    for c in CALENDARS:
        cmd += ["--calendar", c]
    end = (dt.date.today() + dt.timedelta(days=8)).isoformat()
    cmd += ["agenda", "--tsv", "--nodeclined", "today", end]
    shell = 'f=$(mktemp "$1.XXXX") && "${@:3}" > "$f" && mv "$f" "$1"; rm -f "$2"'
    subprocess.Popen(["bash", "-c", shell, "_", CACHE, LOCK, *cmd], start_new_session=True,
                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def events():
    try:
        lines = open(CACHE).read().splitlines()[1:]
    except OSError:
        return []
    out = []
    for line in lines:
        sd, st, ed, et, title = (line.split("\t") + [""] * 5)[:5]
        if st and title not in SKIP:
            out.append((dt.datetime.fromisoformat(f"{sd} {st}"), dt.datetime.fromisoformat(f"{ed} {et}"), title))
    return sorted(set(out))  # an event on both calendars shows once


def fit(text, n=32):
    return text if len(text) <= n else text[:n - 1] + "…"


def until(minutes):
    return f"{minutes // 60}h {minutes % 60:02d}m" if minutes >= 60 else f"{minutes}m"


def when(start, now):
    days = (start.date() - now.date()).days
    if days == 0:
        return f"{start:%H:%M}"
    return f"{'tomorrow' if days == 1 else f'{start:%a}'} {start:%H:%M}"


def main():
    if age(CACHE) > MAX_AGE:
        refresh()
    now = dt.datetime.now()
    left = [e for e in events() if e[1] > now]
    if not left:
        print(json.dumps({"text": "", "class": "none"}))
        return
    start, end, title = left[0]
    if start <= now:
        text, cls = f"now {html.escape(fit(title))} · until {end:%H:%M}", "now"
    else:
        mins = -int(-(start - now).total_seconds() // 60)  # round up: 7m30s left -> 8m
        text = f"{when(start, now)} {html.escape(fit(title))}"
        if start.date() == now.date():
            text += f" · {until(mins)}"
        cls = "soon" if mins <= SOON else "later"
    # tooltip: the rest of that meeting's day
    tip = "\n".join(f"{s:%a %H:%M}–{e:%H:%M}  {html.escape(t)}" for s, e, t in left if s.date() == start.date())
    print(json.dumps({"text": text, "tooltip": tip, "class": cls}))


if __name__ == "__main__":
    main()
