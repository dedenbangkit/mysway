#!/bin/bash
# Screenshot (Print / bottom bar camera button): area, window or entire screen.
# Saved to ~/Pictures and copied to the clipboard.
# Usage: screenshot [area|window|screen]   (no argument: pick from a fuzzel menu)
mode=$1
if [ -z "$mode" ]; then
  sel=$(printf '%s\n' \
      $'  Select area' \
      $'  Window' \
      $'  Entire screen' \
    | fuzzel --dmenu --lines=3 --width=24 --prompt=$'  ' \
        --placeholder='Screenshot…' --match-mode=fuzzy) || exit 0
  case "${sel#*  }" in
    'Select area')   mode=area ;;
    'Window')        mode=window ;;
    'Entire screen') mode=screen ;;
  esac
  # let the menu close before capturing
  sleep 0.2
fi

case "$mode" in
  area)
    geom=$(slurp) || exit 0 ;;
  window)
    # click a window on the visible workspaces
    geom=$(swaymsg -t get_tree | jq -r '.. | select(.pid? and .visible?) | .rect | "\(.x),\(.y) \(.width)x\(.height)"' \
      | slurp -r) || exit 0 ;;
  screen)
    output=$(swaymsg -t get_outputs | jq -r '.[] | select(.focused) | .name') ;;
  *)
    echo "usage: screenshot [area|window|screen]" >&2; exit 1 ;;
esac

file=~/Pictures/screenshot-$(date +%Y%m%d-%H%M%S).png
if [ -n "$geom" ]; then
  grim -g "$geom" "$file"
else
  grim -o "$output" "$file"
fi && wl-copy < "$file" && notify-send -i "$file" 'Screenshot' "Saved to ${file/#$HOME/~} and copied"
