#!/usr/bin/env python3
"""record: start/stop OBS recording (bottom bar record button).

  record          toggle recording; starts OBS in the tray if it isn't running
  record status   JSON for the waybar custom/record module

Talks to OBS through its built-in websocket server; the password is read from
OBS's own obs-websocket config, so there's nothing to keep in sync.
"""
import base64, hashlib, json, os, subprocess, sys

try:
    import websocket  # apt: python3-websocket
except ImportError:
    websocket = None

CONFIG = os.path.expanduser("~/.config/obs-studio/plugin_config/obs-websocket/config.json")
WAYBAR_SIGNAL = 10


def connect():
    if websocket is None:
        raise RuntimeError("python3-websocket is not installed")
    with open(CONFIG) as f:
        cfg = json.load(f)
    ws = websocket.create_connection(f"ws://127.0.0.1:{cfg['server_port']}", timeout=2)
    hello = json.loads(ws.recv())["d"]
    ident = {"rpcVersion": 1, "eventSubscriptions": 0}
    if "authentication" in hello:
        a = hello["authentication"]
        secret = base64.b64encode(hashlib.sha256((cfg["server_password"] + a["salt"]).encode()).digest())
        ident["authentication"] = base64.b64encode(hashlib.sha256(secret + a["challenge"].encode()).digest()).decode()
    ws.send(json.dumps({"op": 1, "d": ident}))
    ws.recv()  # Identified
    return ws


def request(ws, kind):
    ws.send(json.dumps({"op": 6, "d": {"requestType": kind, "requestId": kind}}))
    return json.loads(ws.recv())["d"].get("responseData", {})


def notify(body):
    subprocess.run(["notify-send", "-i", "media-record", "Recording", body])


def status():
    try:
        ws = connect()
        st = request(ws, "GetRecordStatus")
        ws.close()
    except Exception:
        st = None
    if st and st.get("outputActive"):
        time = st["outputTimecode"].split(".")[0]
        out = {"text": f" {time}", "class": "recording", "tooltip": "Recording — click to stop"}
    else:
        tip = "Record screen (OBS)" if st is not None else "Record screen (starts OBS)"
        out = {"text": "", "class": "idle", "tooltip": tip}
    print(json.dumps(out))


def toggle():
    try:
        ws = connect()
    except Exception:
        if subprocess.run(["pgrep", "-x", "obs"], capture_output=True).returncode == 0:
            notify("OBS is running but its websocket server is off\n(Tools → WebSocket Server Settings)")
            return
        subprocess.Popen(["obs", "--startrecording", "--minimize-to-tray", "--disable-shutdown-check"],
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, start_new_session=True)
        return
    if request(ws, "GetRecordStatus").get("outputActive"):
        path = request(ws, "StopRecord").get("outputPath", "")
        notify(f"Saved to {path.replace(os.path.expanduser('~'), '~', 1)}")
    else:
        request(ws, "StartRecord")
    ws.close()


if __name__ == "__main__":
    if sys.argv[1:] == ["status"]:
        status()
    else:
        toggle()
        subprocess.run(["pkill", f"-RTMIN+{WAYBAR_SIGNAL}", "waybar"])
