#!/bin/sh
# Keystroke overlay in the top-right corner (Super+Ctrl+k toggles).
# Uses the patched fork github.com/dedenbangkit/wshowkeys (-l caps the line
# at the last N keys). Install it with:
#   git clone git@github.com:dedenbangkit/wshowkeys ~/Repos/forks/wshowkeys
#   cd ~/Repos/forks/wshowkeys && meson setup build && ninja -C build
#   sudo ninja -C build install && sudo chmod u+s /usr/local/bin/wshowkeys
# It reads /dev/input, so the binary needs setuid root (reinstalling drops it).
if pkill -x wshowkeys; then
  exit 0
fi
exec wshowkeys -a top -a right -m 40 \
  -F 'JetBrainsMono Nerd Font 13' \
  -b '#000000cc' -f '#ffffff' -s '#3584E4' \
  -t 1 -l 15
