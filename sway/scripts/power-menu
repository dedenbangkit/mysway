#!/bin/bash
# Session menu (Super+Shift+p / Super+Shift+e): fuzzel in dmenu mode, same look as the launcher.
lock='swaylock -f'
sel=$(printf '%s\n' \
    $'  Power off' \
    $'  Restart' \
    $'  Suspend' \
    $'  Lock' \
$'  Log out' \
  | fuzzel --dmenu --lines=5 --width=24 --prompt=$'  ' \
      --placeholder='Session…' --match-mode=fuzzy) || exit 0
case "${sel#*  }" in
  'Power off') systemctl poweroff ;;
  'Restart')   systemctl reboot ;;
  'Suspend')   systemctl suspend ;;
  'Lock')      $lock ;;
  'Log out')
    # Lock the encrypted vault first; stay logged in if something still uses it
    if ! "$(dirname "$0")/vault-lock"; then
      notify-send -u critical 'Vault still in use' 'Close files on the vault, then log out again.'
      exit 1
    fi
    swaymsg exit ;;
esac
