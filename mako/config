# Notifications (mako). Only the do-not-disturb mode is set; everything else is mako's default.

# Do not disturb (Super+d / waybar bell, sway/scripts/dnd): hide popups, keep them queued.
# Turning it off shows whatever arrived meanwhile; Super+Shift+n restores dismissed ones.
[mode=do-not-disturb]
invisible=1

# Presenting (wireless display, Extend): popups stay on the laptop, never on the TV's screen.
[mode=presenting]
output=eDP-1

# On-screen indicators (sway/scripts/brightness, sway/scripts/volume): one popup replaced in place, shown even in DND,
# kept out of history.
[app-name=osd]
invisible=0
history=0
